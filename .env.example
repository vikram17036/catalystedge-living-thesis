# StockSense / CatalystEdge — Environment Variables
# Copy to .env (repo root) and fill YOUR values. Never commit .env.

# =============================================================================
# Backend API Keys (Required)
# =============================================================================

# Google Gemini — https://aistudio.google.com/app/apikey
# (This app does NOT use OPENAI_API_KEY today.)
GOOGLE_API_KEY=

# NewsAPI — https://newsapi.org/register
NEWSAPI_KEY=

# =============================================================================
# Supabase (YOUR project — replace friend's URL/keys)
# =============================================================================

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# =============================================================================
# Frontend (Vite) — also put these in frontend/.env.local
# =============================================================================

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8000

# =============================================================================
# Server (Optional)
# =============================================================================

PORT=8000
UVICORN_RELOAD=false
LOG_LEVEL=info
# Production example: https://catalystedge.vercel.app
CORS_ORIGINS=*
